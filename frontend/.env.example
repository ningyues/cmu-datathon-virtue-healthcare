# The default path is proxied to the local Python API by Vite.
# Set an empty value to enable the labelled Figma sample data.
VITE_FACILITIES_API_URL=/api/search

# NABH verification endpoint; Vite proxies /api to the same Python backend.
VITE_NABH_API_URL=/api/nabh/verify

# Institution-level Practo rating lookup, parallel to website verification.
VITE_PRACTO_API_URL=/api/practo/rating
